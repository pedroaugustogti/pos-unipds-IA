{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuardiaoBoardEventV2",
  "description": "Eventos role-based v2: {agent_role}_{status_slug} ou {agent_role}_return_{status_slug}",
  "type": "object",
  "required": ["task_id", "event"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^T-[A-Z0-9]+-\\d+$" },
    "event": {
      "type": "string",
      "pattern": "^(orchestrator_enter_in_progress|orchestrator_todo|[a-z0-9-]+_(in_progress|ready_for_code_review|in_code_review|ready_for_test|in_test|in_pull_request|done|todo|return_in_progress|return_ready_for_code_review|return_in_code_review|return_ready_for_test|return_in_test|return_in_pull_request)|hitl_approved|hitl_rejected|dispute)$"
    },
    "from_agent": { "type": ["string", "null"] },
    "pr_url": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "bug_kind": { "type": ["string", "null"], "enum": ["regression", "flaky", null] },
    "react_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "thought": { "type": "string" },
          "action": { "type": "string" },
          "observation": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": { "pattern": ".+_ready_for_code_review$" }
        }
      },
      "then": {
        "required": ["pr_url", "react_trace"],
        "properties": {
          "pr_url": { "type": "string", "minLength": 8 },
          "react_trace": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
