# Copie/edite este arquivo como crew/.env (gitignored — nao commitar).
# Cursor: https://cursor.com/dashboard/integrations
# OpenRouter: https://openrouter.ai/keys

# OpenRouter (compatível com SDK OpenAI / LangChain / LiteLLM)
OPENAI_API_KEY=
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

GITHUB_TOKEN=
# Org/Project #2 Guardião Família (gh project item-edit)
GUARDAO_GITHUB_ORG=guardiaofamilia
GUARDAO_GITHUB_PROJECT_NUMBER=2
# Status no Project #2 = mesmo Kanban do LangGraph (8 colunas; sync: scripts/sync_project_status_field.py)
GUARDIAO_ISSUE_HISTORY_COMMENTS=1

# --- Fase A: LLM de orquestração (preferir GUARDIAO_LLM_*) ---
GUARDIAO_LLM_ROUTE=deterministic
GUARDIAO_LLM_DEFAULT=openai/gpt-4o-mini
GUARDIAO_LLM_HIGH=x-ai/grok-4.3
# Alias legado opcional (se GUARDIAO_LLM_* ausente):
# CREWAI_MODEL=openai/gpt-4o-mini
# CREWAI_MODEL_HIGH=x-ai/grok-4.3

# --- Cursor SDK (implementação de código — separado da orquestração) ---
CURSOR_API_KEY=

GUARDIAO_CURSOR_MODEL=composer-2.5
# Alias legado:
# GUARDAO_CURSOR_MODEL=composer-2.5

GUARDAO_DISPATCH_BACKEND=auto
GUARDAO_CURSOR_RUNTIME=local
GUARDAO_DISPATCH_WAIT=1
WORKER_LEASE_MINUTES=45

# GUARDAO_API_PATH=
# GUARDAO_PARENT_PATH=
# GUARDAO_CHILD_PATH=
# GUARDAO_BACKOFFICE_PATH=
# GUARDAO_SITE_PATH=

# --- LangSmith / LangChain ---
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=guardiao-familia-agents

# --- Fase C: LangGraph ---
GUARDIAO_ORCHESTRATOR=langgraph
GUARDIAO_LANGGRAPH_MODE=dry_run
GUARDIAO_LANGGRAPH_MAX_STEPS=48
# GUARDIAO_MCP_ALLOW_DISPATCH=0

# --- TLS / certificados (OpenRouter, LangSmith) ---
# Caminho absoluto recomendado no crew/.env local. Se vazio, env_load usa certs/cacert.pem
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=
CURL_CA_BUNDLE=
