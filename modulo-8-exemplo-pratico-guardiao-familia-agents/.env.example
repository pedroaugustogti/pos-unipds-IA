# Copie/edite este arquivo como .env na raiz do módulo 8 (gitignored — nao commitar).
# Cursor: https://cursor.com/dashboard/integrations
# OpenRouter: https://openrouter.ai/keys

# OpenRouter — https://openrouter.ai/keys (fonte canônica de LLM/embeddings)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Aliases legados (SDK OpenAI / LangChain); preenchidos automaticamente se OPENROUTER_* definido
OPENAI_API_KEY=
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

GITHUB_TOKEN=

# --- GitHub Project / board (padrão: Project #2 — módulo 7) ---
GUARDAO_GITHUB_ORG=guardiaofamilia
GUARDAO_GITHUB_PROJECT_NUMBER=2
# GUARDAO_GITHUB_PROJECT_ID=PVT_kwDOEDZbAM4Bg2rE
GUARDAO_TASK_MAP_CSV=TASK_AGENT_MAP.csv
# GUARDAO_BOARD_JSON=  # default: modulo-7/.../github-project-2-import.json

# --- Project #3 sandbox (substitua as vars acima ao treinar agentes) ---
# GUARDAO_GITHUB_PROJECT_NUMBER=3
# GUARDAO_GITHUB_PROJECT_ID=PVT_kwDOEDZbAM4BhlJD
# GUARDAO_TASK_MAP_CSV=TASK_AGENT_MAP_P3.csv
# GUARDAO_BOARD_JSON=board_automation/data/imports/github-project-3-import.json
# QA_STRICT=1
# GUARDAO_MOBILE_FLOW_DB=data/mobile_user_flows.db

GUARDIAO_ISSUE_HISTORY_COMMENTS=1

# --- Fase A: LLM de orquestração (preferir GUARDIAO_LLM_*) ---
GUARDIAO_LLM_ROUTE=deterministic
GUARDIAO_LLM_DEFAULT=openai/gpt-4o-mini
GUARDIAO_LLM_HIGH=x-ai/grok-4.3
# Alias legado opcional (se GUARDIAO_LLM_* ausente):
# CREWAI_MODEL=openai/gpt-4o-mini
# CREWAI_MODEL_HIGH=x-ai/grok-4.3

# --- Cursor SDK (implementação de código — separado da orquestração) ---
CURSOR_API_KEY=

GUARDIAO_CURSOR_MODEL=composer-2.5
# Alias legado:
# GUARDAO_CURSOR_MODEL=composer-2.5

GUARDAO_DISPATCH_BACKEND=auto
GUARDAO_CURSOR_RUNTIME=local
GUARDAO_DISPATCH_WAIT=1
WORKER_LEASE_MINUTES=45

# GUARDAO_API_PATH=
# GUARDAO_PARENT_PATH=
# GUARDAO_CHILD_PATH=
# GUARDAO_BACKOFFICE_PATH=
# GUARDAO_SITE_PATH=

# --- LangSmith / LangChain ---
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=guardiao-familia-agents

# --- Fase C: LangGraph ---
GUARDIAO_ORCHESTRATOR=langgraph
GUARDIAO_LANGGRAPH_MODE=dry_run
GUARDIAO_LANGGRAPH_MAX_STEPS=48
# GUARDIAO_MCP_ALLOW_DISPATCH=0

# --- TLS / certificados (OpenRouter, LangSmith) ---
# Caminho absoluto recomendado no .env local. Se vazio, env_load usa certs/cacert.pem
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=
CURL_CA_BUNDLE=

# --- E2E mobile local (opcional — defaults em lib/mobile/mobile_runtime_config.py) ---
# Origens longas (agents/qa-gate/scripts/mobile_short_paths.ps1 → junctions C:\gf\r\*)
# GF_SOURCE_API=C:\Users\pedro\Documents\guardiao-familia\guardiao-familia-api
# GF_SOURCE_PARENT=C:\Users\pedro\Documents\guardiao-familia\guardiao-familia-parent
