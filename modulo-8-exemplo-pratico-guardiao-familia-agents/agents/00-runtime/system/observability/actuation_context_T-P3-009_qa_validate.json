            "import type { HomeTabId } from '../components/home/TabBar';",
            "",
            "export type HomeDataStatus = 'idle' | 'loading' | 'success' | 'empty' | 'error';",
            "",
            "export type HomeUiState = {",
            "  status: HomeDataStatus;",
            "  activeTab: HomeTabId;",
            "  toastMessage: string | null;",
            "  toastVisible: boolean;",
            "};",
            "",
            "type HomeUiAction =",
            "  | { type: 'LOAD_START' }",
            "  | { type: 'LOAD_SUCCESS'; hasContent: boolean }",
            "  | { type: 'LOAD_ERROR'; message: string }",
            "  | { type: 'TAB_PRESS'; tab: HomeTabId }",
            "  | { type: 'SHOW_TOAST'; message: string }",
            "  | { type: 'HIDE_TOAST' };",
            "",
            "export const INITIAL_HOME_UI_STATE: HomeUiState = {",
            "  status: 'idle',",
            "  activeTab: 'home',",
            "  toastMessage: null,",
            "  toastVisible: false,",
            "};",
            "",
            "export function homeUiReducer(state: HomeUiState, action: HomeUiAction): HomeUiState {",
            "  switch (action.type) {",
            "    case 'LOAD_START':",
            "      return {",
            "        ...state,",
            "        status: 'loading',",
            "      };",
            "    case 'LOAD_SUCCESS':",
            "      return {",
            "        ...state,",
            "        status: action.hasContent ? 'success' : 'empty',",
            "      };",
            "    case 'LOAD_ERROR':",
            "      return {",
            "        ...state,",
            "        status: 'error',",
            "        toastMessage: action.message,",
            "        toastVisible: true,",
            "      };"
