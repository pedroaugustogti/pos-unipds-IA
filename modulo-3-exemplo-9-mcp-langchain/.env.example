# LangSmith / LangChain tracing (mesmo padrão dos exemplos 2+)
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=modulo-3-exemplo-9-mcp-langchain

# LLM via OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Opcional: token da API legada (exemplo 7).
# Se omitido, o launcher do exemplo 8 obtém automaticamente em http://127.0.0.1:9999
# SERVICE_TOKEN=your-service-token-here

# TLS no Windows (OpenRouter / LangSmith)
NODE_OPTIONS=--use-system-ca

# LangGraph dev server
MCP_CONNECT_TIMEOUT_MS=120000
LANGGRAPH_PORT=2024
LANGGRAPH_HOST=localhost
