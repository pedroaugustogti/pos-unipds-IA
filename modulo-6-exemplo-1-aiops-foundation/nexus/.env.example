# Groq API — https://console.groq.com/
GROQ_API_KEY=

# Modelo e limites de resposta (opcional)
# GROQ_MODEL=groq/llama-3.1-8b-instant
# GROQ_MAX_TOKENS=1024

# Economia de tokens / TPM (opcional — defaults já otimizados)
# NEXUS_AGENT_MAX_ITER=3
# NEXUS_AGENT_MAX_RPM=4
# NEXUS_CREW_MAX_RPM=4
# NEXUS_ROUND_DELAY_SECONDS=25
# NEXUS_GROQ_RETRY_ATTEMPTS=3
# NEXUS_GROQ_RETRY_DELAY_SECONDS=30
# NEXUS_MAX_AUDIT_FEEDBACK_ITEMS=8
# NEXUS_USE_FULL_IAC_RULES=false

# Desabilita tracing CrewAI (recomendado em labs)
# CREWAI_TRACING_ENABLED=false
