OPENAI_API_KEY=

# OpenRouter (recomendado — mesmo padrao dos exemplos 8/9)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/pedroaugustogti/pos-unipds-IA
OPENROUTER_X_TITLE=POS UNIPDS - Embeddings Reflexao Evolutiva

RUNTIME_PLANEJADOR=auto

# Unidade 3 — APIs reais
API_BASE_URL=http://localhost:8100
API_KEY=

# PostgreSQL local (python setup_postgres_local.py na raiz do exemplo)
DB_CONNECTION_STRING=postgresql://postgres:unipds@localhost:5433/monitor
EMBEDDING_STORAGE=postgresql
