{
  "name": "frontend-e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "frontend-cypress-e2e/src",
  "implicitDependencies": ["frontend"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cypress run --config-file frontend-cypress-e2e/cypress.config.ts"
      }
    },
    "open-cypress": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cypress open --config-file frontend-cypress-e2e/cypress.config.ts"
      }
    }
  }
}
