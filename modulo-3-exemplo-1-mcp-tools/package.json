{
  "name": "multiple-mcp-tools",
  "version": "1.0.0",
  "description": "LangGraph agent that wraps SerpAPI Google Trends as a LangChain tool to answer video content strategy questions",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file .env src/index.ts",
    "dev": "node --watch --inspect --env-file .env src/index.ts",
    "test": "node --env-file=.env --experimental-strip-types --test test/tools/csvToJSONTool.test.ts test/e2e/http.e2e.test.ts",
    "test:e2e": "node --env-file=.env --experimental-strip-types --test test/e2e/http.e2e.test.ts",
    "test:e2e:full": "node scripts/run-full-e2e.mjs",
    "langgraph:serve": "node scripts/free-langgraph-port.mjs && npx @langchain/langgraph-cli dev",
    "docker:infra:up": "docker compose up -d --wait",
    "docker:infra:down": "docker compose down",
    "docker:infra:cleanup": "docker compose down --volumes --remove-orphans && rm -rf storage",
    "docker:infra:logs": "docker compose logs -f"
  },
  "keywords": [
    "langchain",
    "prompt-chaining",
    "openrouter"
  ],
  "author": "erickwendel",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server-filesystem": "2026.1.14",
    "@langchain/core": "^1.1.49",
    "@langchain/langgraph": "^1.4.1",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.2.9",
    "csvtojson": "^2.0.14",
    "fastify": "^5.7.4",
    "langchain": "^1.2.21",
    "mongodb-mcp-server": "1.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.12"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
