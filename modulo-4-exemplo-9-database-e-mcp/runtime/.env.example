OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/pedroaugustogti/pos-unipds-IA
OPENROUTER_X_TITLE=POS UNIPDS - Database e MCP

# Planejador: auto | mock | llm
RUNTIME_PLANEJADOR=auto

# Fallback opcional (OpenAI direto)
# OPENAI_API_KEY=your-openai-api-key-here

# Unidade 3 — APIs reais (REST adapter)
API_BASE_URL=http://localhost:8100
API_KEY=dev-local-key

# Unidade 3 — Banco de dados SQLite (caminho relativo a modulo-4-exemplo-9-database-e-mcp/)
# Deixe vazio para simulacao didatica (_simulado: true no trace)
DB_CONNECTION_STRING=monitor.db
