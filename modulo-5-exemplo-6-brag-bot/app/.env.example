# --- Provedor LLM (escolha um) ---
# openrouter = usa OPENROUTER_API_KEY (recomendado no curso POS)
# google     = usa GEMINI_API_KEY (material UNIPDS original)
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/unipds-engenharia-de-ia-aplicada
OPENROUTER_X_TITLE=POS UNIPDS - BragBot

# Google AI Studio (alternativa UNIPDS — https://aistudio.google.com/apikey)
GEMINI_API_KEY=

PORT=4000
